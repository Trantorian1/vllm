# Dockerfile for building vLLM with ROCm support targeting AMD RDNA4 gfx1201 (RX 9070 XT)
#
# Build:
#   DOCKER_BUILDKIT=1 docker build -f docker/Dockerfile.rocm.gfx1201 -t vllm-rocm-gfx1201 .
#
# Run (example: serve unsloth/GLM-4.7-Flash-FP8-Dynamic on a single GPU):
#   docker run -it --rm \
#       --group-add=video \
#       --cap-add=SYS_PTRACE \
#       --security-opt seccomp=unconfined \
#       --device /dev/kfd \
#       --device /dev/dri \
#       -v ~/.cache/huggingface:/root/.cache/huggingface \
#       --env "HF_TOKEN=$HF_TOKEN" \
#       -p 8001:8001 \
#       --ipc=host \
#       vllm-rocm-gfx1201 \
#       serve unsloth/GLM-4.7-Flash-FP8-Dynamic \
#           --served-model-name unsloth/GLM-4.7-Flash \
#           --tensor-parallel-size 1 \
#           --tool-call-parser glm47 \
#           --reasoning-parser glm45 \
#           --enable-auto-tool-choice \
#           --dtype bfloat16 \
#           --seed 3407 \
#           --gpu-memory-utilization 0.95 \
#           --max_num_batched_tokens 16384 \
#           --port 8001 \
#           --kv-cache-dtype fp8
#
# Notes:
#   - The base image rocm/vllm-dev:base (ROCm 7.0) already includes PyTorch, Triton,
#     Flash Attention, AITER, and MORI pre-built with gfx1201 in the target list.
#   - AITER and MORI only have kernels for CDNA (gfx942/gfx950), not RDNA4.
#     On RDNA4, vLLM uses Triton-based Flash Attention automatically.
#   - FP8 (OCP format) is supported on gfx12 architectures.
#   - Host system requires ROCm 7.0+ drivers. ROCm 7.0.2+ recommended for RDNA4.

ARG COMMON_WORKDIR=/app
ARG BASE_IMAGE=rocm/vllm-dev:base

# ---- Base stage ----
FROM ${BASE_IMAGE} AS base

# Target only gfx1201 (RX 9070 XT) for faster compilation
ENV PYTORCH_ROCM_ARCH=gfx1201

RUN apt-get update -q -y && apt-get install -q -y \
    sqlite3 libsqlite3-dev libfmt-dev libmsgpack-dev libsuitesparse-dev \
    apt-transport-https ca-certificates wget curl \
    && rm -rf /var/lib/apt/lists/*

RUN python3 -m pip install --upgrade pip

# Install uv
RUN curl -LsSf https://astral.sh/uv/install.sh | env UV_INSTALL_DIR="/usr/local/bin" sh
ENV UV_HTTP_TIMEOUT=500
ENV UV_INDEX_STRATEGY="unsafe-best-match"
ENV UV_LINK_MODE=copy

ARG COMMON_WORKDIR
WORKDIR ${COMMON_WORKDIR}

# ---- Build stage ----
FROM base AS build_vllm

COPY ./ vllm/

RUN cd vllm \
    && python3 -m pip install -r requirements/rocm.txt \
    && python3 setup.py clean --all \
    && python3 setup.py bdist_wheel --dist-dir=dist

# ---- Final stage ----
FROM base AS final

RUN python3 -m pip install --upgrade pip && rm -rf /var/lib/apt/lists/*

# Install huggingface CLI for model downloads
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install --system --upgrade huggingface-hub[cli]

# Install the vLLM wheel and ROCm requirements
ARG COMMON_WORKDIR
RUN --mount=type=bind,from=build_vllm,src=${COMMON_WORKDIR}/vllm/dist,target=/install/dist \
    --mount=type=bind,from=build_vllm,src=${COMMON_WORKDIR}/vllm/requirements,target=/install/requirements \
    --mount=type=cache,target=/root/.cache/uv \
    cd /install \
    && uv pip install --system -r requirements/rocm.txt \
    && pip uninstall -y vllm \
    && uv pip install --system dist/*.whl

# Install nightly transformers (required for GLM-4.7-Flash support)
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install --system --upgrade --force-reinstall \
        "transformers @ git+https://github.com/huggingface/transformers.git"

# Install numba (required by vLLM ROCm for N-gram speculative decoding)
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install --system --force-reinstall numba

# Copy benchmarks and examples for convenience
COPY --from=build_vllm ${COMMON_WORKDIR}/vllm/benchmarks ${COMMON_WORKDIR}/vllm/benchmarks
COPY --from=build_vllm ${COMMON_WORKDIR}/vllm/examples ${COMMON_WORKDIR}/vllm/examples

# ---- Environment tuning ----
ENV TOKENIZERS_PARALLELISM=false
ENV SAFETENSORS_FAST_GPU=1
ENV HIP_FORCE_DEV_KERNARG=1
ENV VLLM_USE_TRITON_FLASH_ATTN=1

# Workaround for ROCm profiler limits
RUN echo "ROCTRACER_MAX_EVENTS=10000000" > ${COMMON_WORKDIR}/libkineto.conf
ENV KINETO_CONFIG="${COMMON_WORKDIR}/libkineto.conf"

ENTRYPOINT ["vllm"]
