# Dockerfile for building vLLM with ROCm support targeting AMD RDNA4 gfx1201 (RX 9070 XT)
#
# Build:
#   DOCKER_BUILDKIT=1 docker build -f docker/Dockerfile.rocm.gfx1201 -t vllm-rocm-gfx1201 .
#
# Run (example: serve unsloth/GLM-4.7-Flash-FP8-Dynamic on a single GPU):
#   docker run -it --rm \
#       --group-add=video \
#       --cap-add=SYS_PTRACE \
#       --security-opt seccomp=unconfined \
#       --device /dev/kfd \
#       --device /dev/dri \
#       -v ~/.cache/huggingface:/root/.cache/huggingface \
#       --env "HF_TOKEN=$HF_TOKEN" \
#       -p 8001:8001 \
#       --ipc=host \
#       vllm-rocm-gfx1201 \
#       serve unsloth/GLM-4.7-Flash-FP8-Dynamic \
#           --served-model-name unsloth/GLM-4.7-Flash \
#           --tensor-parallel-size 1 \
#           --tool-call-parser glm47 \
#           --reasoning-parser glm45 \
#           --enable-auto-tool-choice \
#           --enforce-eager \
#           --dtype bfloat16 \
#           --seed 3407 \
#           --gpu-memory-utilization 0.95 \
#           --max-model-len 8192 \
#           --max_num_batched_tokens 8192 \
#           --port 8001 \
#           --kv-cache-dtype fp8
#
# Notes:
#   - Base image: rocm/vllm-dev RDNA ("navi") image provides ROCm 7.2 runtime,
#     Triton, and other ROCm libraries. However, its pre-installed PyTorch is
#     compiled for gfx1150/gfx1151 (Strix Point APU), NOT gfx1201 (RX 9070 XT).
#     We replace PyTorch with AMD's official ROCm 7.2 wheels from repo.radeon.com
#     which include gfx1201 support.
#   - AITER and MORI only have kernels for CDNA (gfx942/gfx950), not RDNA4.
#     On RDNA4, vLLM uses Triton-based Flash Attention automatically.
#   - FP8 (OCP format) is supported on gfx12 architectures.
#   - Host system requires ROCm 7.2+ drivers for best RDNA4 support.
#   - --enforce-eager is recommended on RDNA4: torch.compile + CUDAGraph capture
#     may not yet be stable on gfx1201.

ARG COMMON_WORKDIR=/app
ARG BASE_IMAGE=rocm/vllm-dev:rocm7.2_navi_ubuntu24.04_py3.12_pytorch_2.9_vllm_0.14.0rc0

# ---- Base stage ----
FROM ${BASE_IMAGE} AS base

# Target only gfx1201 (RX 9070 XT) for faster compilation
ENV PYTORCH_ROCM_ARCH=gfx1201

RUN apt-get update -q -y && apt-get install -q -y \
    sqlite3 libsqlite3-dev libfmt-dev libmsgpack-dev libsuitesparse-dev \
    apt-transport-https ca-certificates wget curl \
    && rm -rf /var/lib/apt/lists/*

# The base image uses a virtualenv at /opt/venv (python3/pip already point there).
RUN python3 -m pip install --upgrade pip

# Install uv
RUN curl -LsSf https://astral.sh/uv/install.sh | env UV_INSTALL_DIR="/usr/local/bin" sh
ENV UV_HTTP_TIMEOUT=500
ENV UV_INDEX_STRATEGY="unsafe-best-match"
ENV UV_LINK_MODE=copy

# CRITICAL: The navi base image's PyTorch is compiled for gfx1150/gfx1151 (Strix
# Point APU), NOT gfx1201 (RX 9070 XT). Replace with AMD's official ROCm 7.2
# wheels from repo.radeon.com which include gfx1201 support.
ARG AMD_ROCM_WHEELS=https://repo.radeon.com/rocm/manylinux/rocm-rel-7.2
RUN pip install --force-reinstall \
    ${AMD_ROCM_WHEELS}/torch-2.9.1+rocm7.2.0.lw.git7e1940d4-cp312-cp312-linux_x86_64.whl \
    ${AMD_ROCM_WHEELS}/torchvision-0.24.0+rocm7.2.0.gitb919bd0c-cp312-cp312-linux_x86_64.whl \
    ${AMD_ROCM_WHEELS}/torchaudio-2.9.0+rocm7.2.0.gite3c6ee2b-cp312-cp312-linux_x86_64.whl \
    ${AMD_ROCM_WHEELS}/triton-3.5.1+rocm7.2.0.gita272dfa8-cp312-cp312-linux_x86_64.whl

# Freeze the newly-installed ROCm PyTorch versions into a constraints file.
# This prevents pip from replacing ROCm builds with CUDA builds from PyPI.
RUN pip freeze | grep -iE '^(torch|torchvision|torchaudio|triton|pytorch-triton)' \
    > /etc/rocm-torch-constraints.txt \
    && echo "--- ROCm PyTorch constraints ---" \
    && cat /etc/rocm-torch-constraints.txt

ARG COMMON_WORKDIR
WORKDIR ${COMMON_WORKDIR}

# ---- Build stage ----
FROM base AS build_vllm

COPY ./ vllm/

# Remove the pre-installed vLLM from the base image before building ours
RUN pip uninstall -y vllm || true

# Install build dependencies with constraints to preserve ROCm PyTorch
RUN cd vllm \
    && python3 -m pip install -c /etc/rocm-torch-constraints.txt -r requirements/rocm.txt \
    && python3 setup.py clean --all \
    && python3 setup.py bdist_wheel --dist-dir=dist

# ---- Final stage ----
FROM base AS final

RUN python3 -m pip install --upgrade pip && rm -rf /var/lib/apt/lists/*

# Install huggingface CLI for model downloads
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install -c /etc/rocm-torch-constraints.txt --upgrade huggingface-hub[cli]

# Install vLLM wheel and ROCm requirements, preserving ROCm PyTorch via constraints
ARG COMMON_WORKDIR
RUN --mount=type=bind,from=build_vllm,src=${COMMON_WORKDIR}/vllm/dist,target=/install/dist \
    --mount=type=bind,from=build_vllm,src=${COMMON_WORKDIR}/vllm/requirements,target=/install/requirements \
    --mount=type=cache,target=/root/.cache/pip \
    cd /install \
    && pip install -c /etc/rocm-torch-constraints.txt -r requirements/rocm.txt \
    && pip uninstall -y vllm \
    && pip install --no-deps dist/*.whl

# Install nightly transformers (required for GLM-4.7-Flash support)
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install -c /etc/rocm-torch-constraints.txt --upgrade --force-reinstall \
        "transformers @ git+https://github.com/huggingface/transformers.git"

# Install numba (required by vLLM ROCm for N-gram speculative decoding)
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install -c /etc/rocm-torch-constraints.txt --force-reinstall numba

# Copy benchmarks and examples for convenience
COPY --from=build_vllm ${COMMON_WORKDIR}/vllm/benchmarks ${COMMON_WORKDIR}/vllm/benchmarks
COPY --from=build_vllm ${COMMON_WORKDIR}/vllm/examples ${COMMON_WORKDIR}/vllm/examples

# ---- Environment tuning ----
ENV TOKENIZERS_PARALLELISM=false
ENV SAFETENSORS_FAST_GPU=1
ENV HIP_FORCE_DEV_KERNARG=1
ENV VLLM_USE_TRITON_FLASH_ATTN=1
# Disable prefill-decode attention split — reported to cause hangs on consumer
# AMD GPUs (ROCm/ROCm#5590).
ENV VLLM_V1_USE_PREFILL_DECODE_ATTENTION=0
# AITER kernels are CDNA-only (gfx942/gfx950), ensure disabled on RDNA4.
ENV VLLM_ROCM_USE_AITER=0

# Workaround for ROCm profiler limits
RUN echo "ROCTRACER_MAX_EVENTS=10000000" > ${COMMON_WORKDIR}/libkineto.conf
ENV KINETO_CONFIG="${COMMON_WORKDIR}/libkineto.conf"

ENTRYPOINT ["vllm"]
